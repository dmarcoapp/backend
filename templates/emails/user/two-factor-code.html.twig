{% extends 'emails/base.html.twig' %}
{% import 'emails/macros.html.twig' as ui %}

{% block preheader %}Your DMARCo sign-in code is {{ code }}.{% endblock %}

{% block content %}
    {{ ui.title('Your sign-in code') }}

    <p style="margin: 0 0 16px 0;">Hi{{ name ? ' ' ~ name : '' }},</p>

    <p style="margin: 0 0 12px 0;">Enter this code to finish signing in to DMARCo:</p>

    <p style="margin: 0 0 20px 0;">
        <span style="display: inline-block; padding: 10px 16px; background-color: #f4f3f6; border: 1px solid #e3e1e8; border-radius: 6px; font-family: Menlo, Consolas, 'Courier New', monospace; font-size: 24px; font-weight: 700; letter-spacing: 4px; color: #1a1720;">{{ code }}</span>
    </p>

    {{ ui.note('The code expires in a few minutes. If you did not try to sign in, someone may know your password: change it right away.') }}
{% endblock %}
