{% extends 'emails/base.html.twig' %}
{% import 'emails/macros.html.twig' as ui %}

{% block preheader %}Sign-in codes now come from your authenticator app.{% endblock %}

{% block content %}
    {{ ui.title('Authenticator app turned on') }}

    <p style="margin: 0 0 16px 0;">Hi{{ name ? ' ' ~ name : '' }},</p>

    <p style="margin: 0 0 16px 0;">
        From now on, DMARCo asks for a code from your authenticator app when you sign in, instead of emailing you one.
    </p>

    <p style="margin: 0 0 16px 0;">
        If you did not make this change, reset your password and check the two-factor settings in your profile.
    </p>

    {{ ui.button(frontend_url ~ '/profile', 'Open your profile') }}
{% endblock %}
