{% extends 'emails/base.txt.twig' %}

{% block content %}
Hi{{ name ? ' ' ~ name : '' }},

We received a request to reset the password of your DMARCo account. Choose a
new one here:

{{ frontend_url }}/auth/password-reset?email={{ tokenEmail|url_encode }}&token={{ token|url_encode }}

The link works for {{ tokenLifetimeHours }} hours. If you did not ask for this,
ignore this email and your password stays the same.
{% endblock %}
