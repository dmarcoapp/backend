{% extends 'emails/base.html.twig' %}
{% import 'emails/macros.html.twig' as ui %}

{% set reset_url = frontend_url ~ '/auth/password-reset?email=' ~ tokenEmail|url_encode ~ '&token=' ~ token|url_encode %}

{% block preheader %}Choose a new password for your DMARCo account.{% endblock %}

{% block content %}
    {{ ui.title('Reset your password') }}

    <p style="margin: 0 0 16px 0;">Hi{{ name ? ' ' ~ name : '' }},</p>

    <p style="margin: 0 0 16px 0;">
        We received a request to reset the password of your DMARCo account. Choose a new one here:
    </p>

    {{ ui.button(reset_url, 'Choose a new password') }}

    {{ ui.note('The link works for ' ~ tokenLifetimeHours ~ ' hours. If you did not ask for this, ignore this email and your password stays the same.') }}

    {{ ui.link_fallback(reset_url) }}
{% endblock %}
