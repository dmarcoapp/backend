<div style="font-family: Arial, sans-serif; color: #1f2937; line-height: 1.5;">
    <p style="margin: 0 0 16px 0;">Hey {{ name }}!</p>

    <p style="margin: 0 0 16px 0;">
        We received a request to reset your DMARCo account password.
    </p>

    <p style="margin: 0 0 16px 0;">
        <a
            href="{{ frontend_url }}/auth/password-reset?email={{ tokenEmail }}&token={{ token }}"
            style="display: inline-block; padding: 10px 14px; background: #c2540a; color: #ffffff; text-decoration: none; border-radius: 6px;"
        >Reset Password</a>
    </p>

    <p style="margin: 0 0 16px 0;">
        This link will remain valid for <strong>{{ tokenLifetimeHours }} hours</strong>.
    </p>

    <p style="margin: 0 0 16px 0;">
        If you did not request a password reset, please ignore this email or contact support.
    </p>

    <p style="margin: 0;">Thank you,<br>The DMARCo Team</p>
</div>
