{% extends 'emails/base.html.twig' %}
{% import 'emails/macros.html.twig' as ui %}

{% set verify_url = frontend_url ~ '/auth/email-verify?email=' ~ tokenEmail|url_encode ~ '&token=' ~ token|url_encode %}

{% block preheader %}Confirm your address to finish setting up your DMARCo account.{% endblock %}

{% block content %}
    {{ ui.title('Verify your email address') }}

    <p style="margin: 0 0 16px 0;">Hi{{ name ? ' ' ~ name : '' }},</p>

    <p style="margin: 0 0 16px 0;">
        Confirm that this is your address to finish setting up your DMARCo account.
    </p>

    {{ ui.button(verify_url, 'Verify email address') }}

    {{ ui.note('The link works for ' ~ tokenLifetimeHours ~ ' hours. If you did not create an account, you can ignore this email.') }}

    {{ ui.link_fallback(verify_url) }}
{% endblock %}
