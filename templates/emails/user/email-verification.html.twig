<div style="font-family: Arial, sans-serif; color: #1f2937; line-height: 1.5;">
    <p style="margin: 0 0 16px 0;">Hey {{ name }}!</p>

    <p style="margin: 0 0 16px 0;">
        Thank you for creating an account with us. To complete your registration, please verify your email address.
    </p>

    <p style="margin: 0 0 16px 0;">
        <a
            href="{{ frontend_url }}/auth/email-verify?email={{ tokenEmail }}&token={{ token }}"
            style="display: inline-block; padding: 10px 14px; background: #c2540a; color: #ffffff; text-decoration: none; border-radius: 6px;"
        >Verify Email Address</a>
    </p>

    <p style="margin: 0 0 16px 0;">
        This verification link will remain valid for <strong>{{ tokenLifetimeHours }} hours</strong>.
    </p>

    <p style="margin: 0 0 16px 0;">
        If you did not create an account, you can safely ignore this email.
    </p>

    <p style="margin: 0;">Welcome aboard,<br>The DMARCo Team</p>
</div>
