{% extends 'emails/base.html.twig' %}
{% import 'emails/macros.html.twig' as ui %}

{% block preheader %}Sign-in codes now come by email again.{% endblock %}

{% block content %}
    {{ ui.title('Authenticator app turned off') }}

    <p style="margin: 0 0 16px 0;">Hi{{ name ? ' ' ~ name : '' }},</p>

    <p style="margin: 0 0 16px 0;">
        Your DMARCo account no longer uses an authenticator app. When you sign in, we email you a code instead.
    </p>

    <p style="margin: 0 0 16px 0;">
        If you did not make this change, reset your password and check the two-factor settings in your profile.
    </p>

    {{ ui.button(frontend_url ~ '/profile', 'Open your profile') }}
{% endblock %}
