{% extends 'emails/base.html.twig' %}
{% import 'emails/macros.html.twig' as ui %}

{% block preheader %}If you did not change it, set a new one right away.{% endblock %}

{% block content %}
    {{ ui.title('Your password was changed') }}

    <p style="margin: 0 0 16px 0;">Hi{{ name ? ' ' ~ name : '' }},</p>

    <p style="margin: 0 0 16px 0;">
        The password of your DMARCo account was just changed. If you did this, there is nothing else to do.
    </p>

    <p style="margin: 0 0 16px 0;">
        If you did not, someone else may have access to your account. Set a new password on your server right away:
    </p>

    <p style="margin: 0 0 16px 0;">
        <code style="font-family: Menlo, Consolas, monospace; font-size: 13px; word-break: break-all;">docker compose exec php bin/console app:user:reset-password</code>
    </p>
{% endblock %}
