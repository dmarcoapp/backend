{# Building blocks shared by the HTML emails, so they look the same everywhere. #}

{% macro title(text) %}
    <h1 style="margin: 0 0 16px 0; font-size: 22px; line-height: 1.3; font-weight: 700; color: #1a1720;">{{ text }}</h1>
{% endmacro %}

{% macro button(url, label) %}
    <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin: 4px 0 20px 0;">
        <tr>
            <td bgcolor="#c2540a" style="background-color: #c2540a; border-radius: 6px;">
                <a href="{{ url }}" style="display: inline-block; padding: 11px 18px; font-size: 15px; font-weight: 600; color: #ffffff; text-decoration: none;">{{ label }}</a>
            </td>
        </tr>
    </table>
{% endmacro %}

{# The address behind a button, for clients that strip links or block the button. #}
{% macro link_fallback(url) %}
    <p style="margin: 0 0 16px 0; font-size: 13px; color: #55505f;">
        If the button does not work, paste this address into your browser:<br>
        <a href="{{ url }}" style="color: #55505f; word-break: break-all;">{{ url }}</a>
    </p>
{% endmacro %}

{% macro note(text) %}
    <p style="margin: 0 0 16px 0; font-size: 13px; color: #55505f;">{{ text }}</p>
{% endmacro %}
