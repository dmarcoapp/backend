<?xml version="1.0" encoding="UTF-8"?>
<phpunit
    bootstrap="vendor/autoload.php"
    colors="true"
    backupGlobals="false"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/12.0/phpunit.xsd"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>src</directory>
        </include>
        <exclude>
            <directory>src/Entity</directory>
        </exclude>
    </source>
    <php>
        <env name="KERNEL_CLASS" value="App\Kernel"/>
        <env name="APP_ENV" value="test"/>
        <env name="APP_DEBUG" value="1"/>
        <env name="APP_SECRET" value="test-secret"/>
        <env name="APP_REGISTRATION_ENABLED" value="true"/>
        <env name="APP_EMAIL_SENDER_ADDRESS" value="no-reply@example.test"/>
        <env name="APP_FRONTEND_URL" value="https://example.test"/>
        <env name="APP_INBOUND_REPORT_EMAIL_WEBHOOK_SECRET" value="test-webhook-secret"/>
        <env name="APP_DMARC_AGGREGATE_REPORT_EMAIL_RECEIVER_DOMAIN" value="aggregate-reports.example.test"/>
        <env name="DEFAULT_URI" value="http://localhost"/>
        <env name="DATABASE_URL" value="sqlite:///%kernel.project_dir%/var/test.db"/>
        <env name="MAILER_DSN" value="null://null"/>
        <env name="JWT_SECRET_KEY" value="%kernel.project_dir%/config/jwt/private.pem"/>
        <env name="JWT_PUBLIC_KEY" value="%kernel.project_dir%/config/jwt/public.pem"/>
        <env name="JWT_PASSPHRASE" value=""/>
        <env name="MESSENGER_ASYNC_LOW_TRANSPORT_DSN" value="sync://"/>
        <env name="MESSENGER_ASYNC_HIGH_TRANSPORT_DSN" value="sync://"/>
        <env name="LOCK_DSN" value="flock"/>
        <env name="CORS_ALLOW_ORIGIN" value="^https?://(localhost|127\\.0\\.0\\.1)(:[0-9]+)?$"/>
        <env name="S3_ENDPOINT" value="http://minio:9000"/>
        <env name="S3_REGION" value="us-east-1"/>
        <env name="S3_ACCESS_KEY" value="minioadmin"/>
        <env name="S3_SECRET_KEY" value="minioadmin"/>
        <env name="S3_BUCKET" value="mail"/>
        <env name="S3_FORCE_PATH_STYLE" value="true"/>
        <env name="REDIS_DSN" value="redis://redis"/>
        <env name="SYMFONY_DEPRECATIONS_HELPER" value="disabled"/>
        <server name="APP_ENV" value="test"/>
        <server name="APP_DEBUG" value="1"/>
        <server name="APP_SECRET" value="test-secret"/>
        <server name="APP_REGISTRATION_ENABLED" value="true"/>
        <server name="APP_EMAIL_SENDER_ADDRESS" value="no-reply@example.test"/>
        <server name="APP_FRONTEND_URL" value="https://example.test"/>
        <server name="APP_INBOUND_REPORT_EMAIL_WEBHOOK_SECRET" value="test-webhook-secret"/>
        <server name="APP_DMARC_AGGREGATE_REPORT_EMAIL_RECEIVER_DOMAIN" value="aggregate-reports.example.test"/>
        <server name="DEFAULT_URI" value="http://localhost"/>
        <server name="DATABASE_URL" value="sqlite:///%kernel.project_dir%/var/test.db"/>
        <server name="MAILER_DSN" value="null://null"/>
        <server name="JWT_SECRET_KEY" value="%kernel.project_dir%/config/jwt/private.pem"/>
        <server name="JWT_PUBLIC_KEY" value="%kernel.project_dir%/config/jwt/public.pem"/>
        <server name="JWT_PASSPHRASE" value=""/>
        <server name="MESSENGER_ASYNC_LOW_TRANSPORT_DSN" value="sync://"/>
        <server name="MESSENGER_ASYNC_HIGH_TRANSPORT_DSN" value="sync://"/>
        <server name="LOCK_DSN" value="flock"/>
        <server name="CORS_ALLOW_ORIGIN" value="^https?://(localhost|127\\.0\\.0\\.1)(:[0-9]+)?$"/>
        <server name="S3_ENDPOINT" value="http://minio:9000"/>
        <server name="S3_REGION" value="us-east-1"/>
        <server name="S3_ACCESS_KEY" value="minioadmin"/>
        <server name="S3_SECRET_KEY" value="minioadmin"/>
        <server name="S3_BUCKET" value="mail"/>
        <server name="S3_FORCE_PATH_STYLE" value="true"/>
        <server name="REDIS_DSN" value="redis://redis"/>
        <server name="SYMFONY_DEPRECATIONS_HELPER" value="disabled"/>
        <ini name="display_errors" value="1"/>
        <ini name="error_reporting" value="-1"/>
        <ini name="memory_limit" value="512M"/>
    </php>
</phpunit>
